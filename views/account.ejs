<%- include('partials/head', { title: title, era: 1, noindex: true }) %>
<%- include('partials/topbar') %>
<main class="container" style="max-width:760px;padding:2rem 0 3rem">
  <h1 style="font-size:2.2rem">Mein Konto</h1>
  <p class="dim">Hier verwaltest du deine Zugangsdaten und deine Daten – Auskunft, Export und Löschung nach DSGVO.</p>
  <% if (error) { %><div class="alert bad"><%- icon('circle-alert') %><div><%= error %></div></div><% } %>
  <% if (notice) { %><div class="alert good"><%- icon('circle-check') %><div><%= notice %></div></div><% } %>

  <section class="card stack">
    <div class="card-title"><%- icon('user') %> Profil</div>
    <dl class="kv"><dt>Spielername</dt><dd><%= u.username %></dd><dt>E-Mail</dt><dd><%= u.email %> <% if (!u.email_verified) { %><span class="chip warn">nicht bestätigt</span><% } %></dd><dt>Registriert</dt><dd><%= new Date(u.created_at).toLocaleDateString('de-DE') %></dd><dt>Charaktere</dt><dd><%= characters %></dd></dl>
    <div class="row"><a class="btn" href="/play"><%- icon('play') %> Zum Spiel</a><a class="btn ghost" href="/play#/social">Sichtbarkeit &amp; Profiltext (Spieler → Mein Profil)</a></div>
  </section>

  <section class="card stack mt">
    <div class="card-title"><%- icon('key') %> Passwort ändern</div>
    <form method="post" action="/account/password" class="stack" style="--gap:.8rem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="cur1">Aktuelles Passwort</label><input id="cur1" name="current" type="password" autocomplete="current-password" required></div>
      <div class="grid c2"><div class="field"><label for="pw">Neues Passwort</label><input id="pw" name="pw" type="password" autocomplete="new-password" minlength="10" required><div class="hint">Mindestens 10 Zeichen.</div></div>
      <div class="field"><label for="pw2">Wiederholen</label><input id="pw2" name="pw2" type="password" autocomplete="new-password" minlength="10" required></div></div>
      <div class="row end"><button class="btn primary">Passwort speichern</button></div>
    </form>
  </section>

  <section class="card stack mt">
    <div class="card-title"><%- icon('mail') %> E-Mail-Adresse ändern</div>
    <form method="post" action="/account/email" class="stack" style="--gap:.8rem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid c2"><div class="field"><label for="em">Neue E-Mail</label><input id="em" name="email" type="email" autocomplete="email" required></div>
      <div class="field"><label for="cur2">Aktuelles Passwort</label><input id="cur2" name="current" type="password" autocomplete="current-password" required></div></div>
      <div class="row end"><button class="btn primary">E-Mail speichern</button></div>
    </form>
  </section>

  <section class="card stack mt" id="uicard">
    <div class="card-title"><%- icon('layers') %> Anzeige im Spiel</div>
    <label class="check"><input type="checkbox" id="showall" disabled> Alle Funktionen anzeigen</label>
    <p class="dim small mb0">Standardmäßig schalten sich fortgeschrittene Bereiche (Unternehmen, Gesellschaft, Börse, Wahlen, Markt, Bank) nach und nach frei, damit der Einstieg übersichtlich bleibt. Mit diesem Schalter ist von Anfang an alles sichtbar. Es wird nichts entfernt oder gesperrt.</p>
  </section>
  <script src="/js/account-ui.js" defer></script>

  <section class="card stack mt" id="pushcard" data-enabled="<%= pushEnabled ? 1 : 0 %>">
    <div class="card-title"><%- icon('bell') %> Benachrichtigungen auf dem Handy</div>
    <p class="dim small mb0">Wenn du Turning Point als App installiert hast, kann dich das Spiel per Push benachrichtigen – auch bei geschlossener App: neue Briefe, Erwähnungen im Stadtplatz-Chat, Kaufangebote, Überbieten bei Versteigerungen, Beziehungsanfragen und Jobangebote. Du kannst das jederzeit ausschalten; jedes Gerät meldest du einzeln an.</p>
    <div class="alert info" id="push-unsupported" style="display:none"><%- icon('info') %><div>Dieses Gerät oder dieser Browser unterstützt keine Push-Benachrichtigungen. Auf dem iPhone muss die App zuerst über „Zum Home-Bildschirm“ installiert werden.</div></div>
    <div class="alert warn" id="push-off" style="display:none"><%- icon('info') %><div>Push-Benachrichtigungen sind derzeit vom Betreiber abgeschaltet.</div></div>
    <div class="row"><button type="button" class="btn primary" id="push-toggle" disabled>Benachrichtigungen einschalten</button><button type="button" class="btn ghost" id="push-test" style="display:none">Testnachricht senden</button><span class="dim small" id="push-state"></span></div>
    <div id="push-opts" class="stack" style="--gap:.6rem;display:none">
      <div class="card-title" style="font-size:1rem">Worüber möchtest du informiert werden?</div>
      <label class="check"><input type="checkbox" data-pcat="letters"> Neue Briefe und Freundschaftsanfragen</label>
      <label class="check"><input type="checkbox" data-pcat="chat"> Erwähnungen im Stadtplatz-Chat (@Spielername)</label>
      <label class="check"><input type="checkbox" data-pcat="offers"> Kauf- und Gegenangebote</label>
      <label class="check"><input type="checkbox" data-pcat="auctions"> Überboten bei Versteigerungen</label>
      <label class="check"><input type="checkbox" data-pcat="couples"> Beziehungs- und Heiratsanfragen</label>
      <label class="check"><input type="checkbox" data-pcat="jobs"> Bewerbungen und Jobangebote</label>
      <label class="check"><input type="checkbox" id="push-quiet"> Ruhezeit: keine Benachrichtigungen von <input type="number" id="push-qfrom" min="0" max="23" style="width:4.2rem"> bis <input type="number" id="push-qto" min="0" max="23" style="width:4.2rem"> Uhr (Ortszeit deines Geräts)</label>
      <div class="row end"><button type="button" class="btn" id="push-save">Auswahl speichern</button></div>
    </div>
  </section>
  <script src="/js/push-settings.js" defer></script>

  <section class="card stack mt">
    <div class="card-title"><%- icon('database') %> Meine Daten (Auskunft &amp; Export)</div>
    <p class="dim small mb0">Du erhältst alle zu deinem Konto gespeicherten Daten als JSON-Datei: Kontodaten, Charaktere und Spielstände, Rangliste, Freunde, Briefe, Chat-Beiträge, Beziehungen, Jobs, IP-Adressen, Käufe und Meldungen. Passwort-Hash und Sicherheits-Token sind nicht enthalten.</p>
    <div class="row"><a class="btn" href="/account/export" download><%- icon('download') %> Daten herunterladen (JSON)</a></div>
  </section>

  <section class="card stack mt" style="border-color:color-mix(in srgb, var(--bad) 45%, var(--border))">
    <div class="card-title" style="color:var(--bad)"><%- icon('triangle-alert') %> Konto löschen</div>
    <p class="dim small mb0">Das Konto wird <b>endgültig</b> gelöscht: Charaktere, Spielstände, Coins, EFS, Dauerkarte, Freunde, Briefe an dich, Chat-Beiträge und Betriebe. Beziehungen und Arbeitsverhältnisse mit anderen Spielern enden. Briefe, die du anderen geschickt hast, bleiben ohne Absender erhalten. Käufe bleiben anonymisiert gespeichert, weil das Gesetz eine Aufbewahrung vorschreibt. <b>Das lässt sich nicht rückgängig machen.</b></p>
    <details <%= typeof openDelete !== 'undefined' && openDelete ? 'open' : '' %>><summary class="btn ghost danger">Ich möchte mein Konto löschen …</summary>
      <form method="post" action="/account/delete" class="stack mt" style="--gap:.8rem">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="cur3">Passwort</label><input id="cur3" name="current" type="password" autocomplete="current-password" required></div>
        <div class="field"><label for="cf">Tippe LÖSCHEN ein</label><input id="cf" name="confirm" type="text" autocomplete="off" required placeholder="LÖSCHEN"></div>
        <div class="row end"><button class="btn danger" <%= impersonating ? 'disabled' : '' %>>Konto endgültig löschen</button></div>
      </form>
    </details>
  </section>
</main>
<%- include('partials/foot') %>
