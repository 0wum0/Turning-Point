<%- include('_top', { actions: '<a class="btn sm" href="/admin/settings/gericht">Einstellungen</a>' }) %>
<% var csrf = '<input type="hidden" name="_csrf" value="' + csrfToken + '">'; const when = (d) => new Date(Number(d)).toLocaleString('de-DE', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }); %>
<div class="kpis">
  <div class="kpi info"><span class="ico"><%- icon('search') %></span><label>Offene Spuren</label><b><%= k.ev %></b></div>
  <div class="kpi"><span class="ico"><%- icon('gavel') %></span><label>Laufende Verfahren</label><b><%= k.open %></b></div>
  <div class="kpi"><span class="ico"><%- icon('scale') %></span><label>Schuldsprüche</label><b><%= k.guilty %></b></div>
  <div class="kpi <%= k.restr ? 'bad' : 'good' %>"><span class="ico"><%- icon('lock') %></span><label>Aktive Einschränkungen</label><b><%= k.restr %></b></div>
</div>
<form class="card stack mt" method="post" action="/admin/court/enabled"><%- csrf %>
  <div class="card-title"><%- icon('gavel') %> Gerichtswesen</div>
  <label class="check"><input type="radio" name="enabled" value="1" <%= cfg.enabled !== false ? 'checked' : '' %>> <b>An</b></label>
  <label class="check"><input type="radio" name="enabled" value="0" <%= cfg.enabled === false ? 'checked' : '' %>> <b>Aus</b> – keine neuen Spuren, keine Sperren.</label>
  <div class="row end"><button class="btn primary"><%- icon('check') %> Speichern</button></div>
</form>
<h3 class="mt">Aktive Sanktionen</h3>
<div class="table-wrap"><table class="table small"><thead><tr><th>Konto</th><th>Art</th><th>Stufe</th><th>Betrag (1945)</th><th>Bis</th><th></th></tr></thead><tbody>
<% sanctions.forEach(function(s){ %><tr><td><%= s.un %></td><td><%= SANCTIONS[s.kind] || s.kind %></td><td><%= s.level %></td><td class="num"><%= s.amount_real ? Math.round(s.amount_real - s.paid_real) / 100 : '' %></td><td class="dim"><%= s.until_ms ? when(s.until_ms) : (s.due_ms ? 'zahlbar bis ' + when(s.due_ms) : '') %></td>
<td class="num"><form method="post" action="/admin/court/user/<%= s.user_id %>/sanction/<%= s.id %>/annul" class="inline"><%- csrf %><button class="btn sm danger" data-confirm="Sanktion aufheben?">Aufheben</button></form></td></tr>
<% }) %><% if (!sanctions.length) { %><tr><td colspan="6" class="dim">Keine aktiven Sanktionen.</td></tr><% } %></tbody></table></div>
<h3 class="mt">Verfahren</h3>
<div class="table-wrap"><table class="table small"><thead><tr><th>Nr.</th><th>Zeit</th><th>Kläger</th><th>Beklagter</th><th>Tat</th><th>Stand</th><th>Urteil</th><th></th></tr></thead><tbody>
<% cases.forEach(function(c){ %><tr><td>#<%= c.id %></td><td class="dim"><%= when(c.created_ms) %></td><td><%= c.pu %></td><td><%= c.du %></td><td><%= ACTS[c.act] || c.act %></td><td><%= STATE[c.state] || c.state %></td><td><%= c.guilty == null ? '' : (c.guilty ? 'schuldig (Stufe ' + c.level + ')' : 'Freispruch') %></td>
<td class="num"><% if (['filed','investigation','hearing','verdict','appeal','final'].includes(c.state)) { %><form method="post" action="/admin/court/user/<%= c.defendant_id %>/case/<%= c.id %>/annul" class="inline"><%- csrf %><button class="btn sm danger" data-confirm="Verfahren aufheben und Sanktionen annullieren?">Aufheben</button></form><% } %></td></tr>
<% }) %><% if (!cases.length) { %><tr><td colspan="8" class="dim">Noch keine Verfahren.</td></tr><% } %></tbody></table></div>
<%- include('_bottom') %>
