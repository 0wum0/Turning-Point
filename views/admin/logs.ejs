<%- include('_top', { actions: '<a class="btn sm" href="/admin/logs/download">Log herunterladen</a>' }) %>
<form class="row wrap" method="get" style="margin-bottom:1rem">
  <select name="level" style="max-width:140px"><% [['', 'Alle Stufen'], ['error', 'Fehler'], ['warn', 'Warnungen'], ['info', 'Info']].forEach(function(o){ %><option value="<%= o[0] %>" <%= level === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select>
  <input type="search" name="q" value="<%= q %>" placeholder="Suchen …" style="max-width:260px">
  <select name="n" style="max-width:150px"><% [200, 400, 1000, 3000].forEach(function(v){ %><option value="<%= v %>" <%= n === v ? 'selected' : '' %>>letzte <%= v %> Zeilen</option><% }) %></select>
  <button class="btn"><%- icon('search') %> Filtern</button><span class="dim small"><%= lines.length %> Zeilen · neueste oben</span></form>
<pre class="logbox" style="max-height:none"><%= lines.join('\n') || 'Keine Einträge.' %></pre>
<%- include('_bottom') %>
