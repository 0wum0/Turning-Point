<%- include('_top', { actions: '<a class="btn sm" href="/admin/professions">← Alle Berufe</a>' }) %>
<form class="card" method="post" action="/admin/professions/<%= p.id %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="grid c3">
    <div class="field"><label>Name</label><input type="text" name="name" value="<%= p.name %>" required></div>
    <div class="field"><label>Schlüssel (a–z, 0–9, _)</label><input type="text" name="pkey" value="<%= p.pkey %>" required></div>
    <div class="field"><label>Kategorie</label><input type="text" name="category" value="<%= p.category %>"></div>
    <div class="field"><label>Icon (Lucide-Name aus dem Sprite)</label><input type="text" name="icon" value="<%= p.icon %>"><div class="hint">z. B. hammer, wheat, scissors, cpu, truck, zap …</div></div>
    <div class="field"><label>Verfügbar ab Jahr</label><input type="number" name="era_from" value="<%= p.era_from %>"></div>
    <div class="field"><label>Verfügbar bis Jahr (2999 = offen)</label><input type="number" name="era_to" value="<%= p.era_to %>"></div>
    <div class="field"><label>Tageslohn in Cent (Preisindex 1945)</label><input type="number" name="base_wage" value="<%= p.base_wage %>"><div class="hint">600 = 6,00 DM</div></div>
    <div class="field"><label>Ausbildungs-/Studiendauer (Tage)</label><input type="number" name="training_days" value="<%= p.training_days %>"></div>
    <div class="field"><label>Studiengebühr/Tag in Cent</label><input type="number" name="tuition_day" value="<%= p.tuition_day %>"></div>
    <div class="field"><label>Ersetzt Beruf (Schlüssel)</label><input type="text" name="replaces" value="<%= p.replaces || '' %>"></div>
    <div class="field"><label>Schaltet frei (Unternehmen)</label><input type="text" name="unlocks" value="<%= p.unlocks || '' %>"></div>
    <div class="field"><label>Beschreibung</label><input type="text" name="description" value="<%= p.description || '' %>"></div>
  </div>
  <div class="row" style="gap:1.5rem"><label class="check"><input type="checkbox" name="academic" value="1" <%= p.academic ? 'checked' : '' %>> Akademisch (Studium, kostenpflichtig)</label><label class="check"><input type="checkbox" name="lodging" value="1" <%= p.lodging ? 'checked' : '' %>> Arbeitgeber bietet oft Schlafplatz</label><label class="check"><input type="checkbox" name="active" value="1" <%= p.active ? 'checked' : '' %>> Aktiv</label></div>
  <div class="row end mt"><button class="btn primary"><%- icon('check') %> Speichern</button></div>
</form>
<%- include('_bottom') %>
