<%- include('_top', { actions: '<a class="btn primary sm" href="/admin/professions/new">+ Neuer Beruf</a>' }) %>
<p class="dim">Berufe sind epochenabhängig (von/bis Jahr). „Ersetzt“ verknüpft einen Beruf mit seinem Vorgänger (z. B. Schmied → Maschinenbauer), damit sich Berufe alle ~20 Jahre wandeln.</p>
<div class="table-wrap"><table class="table"><thead><tr><th>Beruf</th><th>Schlüssel</th><th>Kategorie</th><th>Zeitraum</th><th class="num">Lohn/Tag (Cent)</th><th class="num">Ausbildung (Tage)</th><th>Ersetzt</th><th>Status</th><th></th></tr></thead>
<tbody><% rows.forEach(function(p){ %><tr><td><a href="/admin/professions/<%= p.id %>"><b><%= p.name %></b></a> <% if (p.academic) { %><span class="chip accent">Studium</span><% } %></td><td class="dim small"><%= p.pkey %></td><td class="dim"><%= p.category %></td><td class="small"><%= p.era_from %>–<%= p.era_to >= 2999 ? 'offen' : p.era_to %></td><td class="num"><%= p.base_wage %></td><td class="num"><%= p.training_days %></td><td class="dim small"><%= p.replaces || '–' %></td><td><span class="chip <%= p.active ? 'good' : '' %>"><%= p.active ? 'aktiv' : 'aus' %></span></td><td class="num"><a class="btn sm" href="/admin/professions/<%= p.id %>">Bearbeiten</a></td></tr><% }) %></tbody></table></div>
<%- include('_bottom') %>
