<%- include('_top', { actions: '' }) %>
<% var csrf = '<input type="hidden" name="_csrf" value="' + csrfToken + '">'; %>
<div class="grid c2" style="--gap:1rem">
  <section class="card"><div class="card-title">Coins &amp; EFS an Gruppe verteilen</div>
    <form class="stack" style="--gap:.6rem" method="post" action="/admin/tools/grant"><%- csrf %>
      <div class="field"><label>Empfänger</label><select name="target"><option value="all">Alle (<%= counts.users %>)</option><option value="players">Nur Spieler</option><option value="active7">Aktiv in den letzten 7 Tagen (<%= counts.active %>)</option><option value="subs">Nur Dauerkarten-Inhaber</option></select></div>
      <div class="row"><div class="field"><label>Coins (±)</label><input type="number" name="coins" value="0"></div><div class="field"><label>EFS (±)</label><input type="number" name="efs" value="0"></div></div>
      <button class="btn primary" data-confirm="Diese Buchung bei der gesamten Gruppe durchführen?">Verteilen</button></form></section>
  <section class="card"><div class="card-title">Meldung an alle lebenden Charaktere (<%= counts.alive %>)</div>
    <form class="stack" style="--gap:.6rem" method="post" action="/admin/tools/broadcast"><%- csrf %>
      <div class="row"><select name="level" style="max-width:120px"><option>info</option><option>good</option><option>warn</option><option>bad</option></select><input type="text" name="title" placeholder="Titel" maxlength="80"></div>
      <textarea name="text" placeholder="Text der Meldung" maxlength="500" style="min-height:90px"></textarea>
      <label class="check"><input type="checkbox" name="interrupt" value="1"> als Pop-up anzeigen</label>
      <button class="btn primary" data-confirm="Meldung an alle lebenden Charaktere senden?">Senden</button></form>
    <div class="hint mt">Für ein dauerhaftes Banner nutze <a href="/admin/settings/announce">Einstellungen → Ankündigung</a>.</div></section>
</div>
<section class="card mt"><div class="card-title">Stadtwirtschaft (Preisindizes)</div>
  <p class="small dim mb0">Städte mit Aktivität: <b><%= cityecon.cities %></b> (<%= cityecon.rows %> Zeilen)<% if (cityecon.last && cityecon.last.at) { %> · letzte Berechnung <%= new Date(cityecon.last.at).toLocaleString('de-DE') %> (<%= cityecon.last.ms %> ms)<% } %> · Stadtwirtschaft ist <b><%= cityecon.on ? 'an' : 'aus' %></b>. Einstellungen: <a href="/admin/settings/stadtwirtschaft">Stadtwirtschaft</a>.</p>
  <div class="row mt">
    <form method="post" action="/admin/tools/cityecon"><%- csrf %><input type="hidden" name="what" value="refresh"><button class="btn sm">Jetzt neu berechnen</button></form>
    <form method="post" action="/admin/tools/cityecon"><%- csrf %><input type="hidden" name="what" value="reset"><button class="btn sm danger" data-confirm="Alle Stadtindizes auf 1 zurücksetzen? Sie entwickeln sich danach aus Angebot und Nachfrage neu.">Alle zurücksetzen</button></form>
  </div></section>
<section class="card mt"><div class="card-title">Jahreszeiten, Ernte &amp; Seuchen (Test)</div>
  <p class="small dim mb0">Erzwingt ein Ereignis zu einem bestimmten <b>Spieldatum</b> (Jahr und Tag im Jahr, 0 = 1. Januar). Es gilt für alle Spieler, die dieses Datum erreichen. Jede Änderung wird im Protokoll vermerkt.</p>
  <div class="grid c2 mt" style="--gap:1rem">
    <form class="stack" style="--gap:.5rem" method="post" action="/admin/tools/seasons"><%- csrf %><input type="hidden" name="what" value="epi_start"><b>Seuche starten</b>
      <div class="row"><div class="field"><label>Name</label><input type="text" name="name" value="Testfieber" maxlength="60"></div><div class="field"><label>Ursprungsstadt</label><input type="text" name="origin" placeholder="z. B. Hamburg" maxlength="80"></div></div>
      <div class="row"><div class="field"><label>Spieljahr</label><input type="number" name="year" value="1950" min="1945" max="2200"></div><div class="field"><label>Tag im Jahr</label><input type="number" name="doy" value="0" min="0" max="364"></div><div class="field"><label>Dauer (Tage)</label><input type="number" name="duration" value="120" min="20" max="400"></div></div>
      <div class="row"><div class="field"><label>Schwere (0,05–1)</label><input type="text" name="sev" value="0.6"></div><div class="field"><label>Art</label><select name="kind"><option value="pandemic">Pandemie</option><option value="flu">Grippewelle</option></select></div><div class="field"><label>Standardmaßnahme (0–3)</label><input type="number" name="level" value="1" min="0" max="3"></div><div class="field"><label>Impfstoff nach (Tage)</label><input type="number" name="vacc" value="90" min="0" max="400"></div></div>
      <button class="btn primary">Seuche starten</button></form>
    <form class="stack" style="--gap:.5rem" method="post" action="/admin/tools/seasons"><%- csrf %><input type="hidden" name="what" value="harvest_set"><b>Ernte festlegen</b>
      <div class="row"><div class="field"><label>Spieljahr</label><input type="number" name="year" value="1950" min="1945" max="2200"></div><div class="field"><label>Ertrag (0,4–1,4; 1 = normal)</label><input type="text" name="yield" value="0.7"></div></div>
      <div class="row"><div class="field"><label>Bundesland (leer = ganzes Land)</label><input type="text" name="region" maxlength="60"></div><div class="field"><label>Bezeichnung</label><input type="text" name="name" maxlength="60" placeholder="z. B. Dürrejahr"></div></div>
      <button class="btn primary">Ernte festlegen</button></form>
  </div>
  <div class="mt small"><b>Aktive Testereignisse:</b>
    <% if (!seasonForced.epi.length && !seasonForced.harvest.length) { %> <span class="dim">keine</span><% } %>
    <% seasonForced.epi.forEach(function (e) { %><form class="row nowrap mt" method="post" action="/admin/tools/seasons"><%- csrf %><input type="hidden" name="what" value="epi_end"><input type="hidden" name="id" value="<%= e.id %>"><span class="grow">Seuche „<%= e.name %>“ ab Spieljahr <%= e.year %>, Tag <%= e.doy %><%= e.origin ? ' (' + e.origin + ')' : '' %></span><button class="btn sm danger">Beenden</button></form><% }) %>
    <% seasonForced.harvest.forEach(function (h) { %><div class="mt">Ernte <%= h.year %><%= h.region ? ' · ' + h.region : '' %>: Ertrag <%= Math.round(h.yield * 100) %> %</div><% }) %>
    <% if (seasonForced.harvest.length) { %><form class="mt" method="post" action="/admin/tools/seasons"><%- csrf %><input type="hidden" name="what" value="harvest_clear"><button class="btn sm danger">Erzwungene Ernten löschen</button></form><% } %>
  </div></section>
<section class="card mt"><div class="card-title">Aufräumen</div>
  <div class="grid c3" style="--gap:.8rem">
    <% [['sessions', 'Abgelaufene Sitzungen löschen', false, 0], ['audit', 'Protokoll älter als … Tage löschen', true, counts.audit], ['ads', 'Werbe-Einträge älter als … Tage löschen', true, counts.ads], ['unverified', 'Unbestätigte Konten ohne Charakter älter als … Tage löschen', true, 0], ['inactive', 'Inaktive Konten (0 Coins, keine Dauerkarte) seit … Tagen löschen', true, 0]].forEach(function(c){ %>
      <form class="row nowrap" method="post" action="/admin/tools/cleanup"><%- csrf %><input type="hidden" name="what" value="<%= c[0] %>"><div class="grow small"><%= c[1] %><% if (c[3]) { %> <span class="dim">(<%= c[3] %>)</span><% } %></div><% if (c[2]) { %><input type="number" name="days" value="90" min="1" style="width:80px"><% } %><button class="btn sm danger" data-confirm="Wirklich aufräumen? Das kann nicht rückgängig gemacht werden.">Ausführen</button></form>
    <% }) %></div></section>
<%- include('_bottom') %>
