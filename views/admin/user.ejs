<%- include('_top', { actions: '<a class="btn sm" href="/admin/users">← Alle Spieler</a>' }) %>
<% var csrf = '<input type="hidden" name="_csrf" value="' + csrfToken + '">'; %>
<form class="card" method="post" action="/admin/users/<%= u.id %>/edit">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-title">Konto bearbeiten <span class="dim small">#<%= u.id %> · registriert <%= new Date(u.created_at).toLocaleString('de-DE') %> · letzter Login <%= u.last_login_at ? new Date(u.last_login_at).toLocaleString('de-DE') : '–' %></span></div>
  <div class="grid c3">
    <div class="field"><label>Benutzername</label><input type="text" name="username" value="<%= u.username %>" required maxlength="40"></div>
    <div class="field"><label>E-Mail</label><input type="email" name="email" value="<%= u.email %>" required></div>
    <div class="field"><label>Rolle</label><select name="role" <%= u.id === user.id ? 'disabled' : '' %>><option value="player" <%= u.role === 'player' ? 'selected' : '' %>>Spieler</option><option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option></select></div>
    <div class="field"><label>Coins</label><input type="number" name="coins" value="<%= u.coins %>" min="0"></div>
    <div class="field"><label>EFS-Vorrat</label><input type="number" name="efs_pool" value="<%= u.efs_pool %>" min="0"></div>
    <div class="field"><label>Dauerkarte läuft bis</label><input type="datetime-local" name="sub_until" value="<%= subLocal %>"><div class="hint">Leer = keine Dauerkarte.</div></div>
    <div class="field"><label>Neues Passwort setzen (optional, min. 8 Zeichen)</label><input type="text" name="new_password" autocomplete="off" placeholder="leer lassen = unverändert"></div>
    <div class="field"><label class="check" style="margin-top:1.7rem"><input type="checkbox" name="email_verified" value="1" <%= u.email_verified ? 'checked' : '' %>> E-Mail bestätigt</label></div>
    <div class="field"><label class="check" style="margin-top:1.7rem"><input type="checkbox" name="reset_bonus" value="1"> Tages-Login-Bonus zurücksetzen</label></div>
    <div class="field"><label class="check"><input type="checkbox" name="banned" value="1" <%= u.banned ? 'checked' : '' %> <%= u.id === user.id ? 'disabled' : '' %>> Gesperrt</label><input type="text" name="ban_reason" value="<%= u.ban_reason || '' %>" placeholder="Sperrgrund" maxlength="200"></div>
  </div>
  <div class="field"><label>Spieler-Meta (bleibt über alle Leben: Einfluss, Abschlüsse, Zyklen, …)</label><textarea class="code" name="meta" data-tree spellcheck="false"><%= JSON.stringify(meta, null, 2) %></textarea></div>
  <div class="row end"><button class="btn primary"><%- icon('check') %> Speichern</button></div>
</form>

<div class="grid c2 mt" style="--gap:1rem">
  <section class="card"><div class="card-title">Schnellbuchung</div>
    <form class="row" method="post" action="/admin/users/<%= u.id %>/coins"><%- csrf %><input type="number" name="amount" value="10" style="width:110px"><button class="btn sm">Coins ±</button></form>
    <form class="row mt" method="post" action="/admin/users/<%= u.id %>/efs"><%- csrf %><input type="number" name="amount" value="100" style="width:110px"><button class="btn sm">EFS ±</button></form>
    <div class="dim small mt"><%= sessions %> aktive Sitzung(en)</div>
  </section>
  <section class="card"><div class="card-title">Aktionen</div>
    <div class="row wrap">
      <% if (u.id !== user.id) { %><form method="post" action="/admin/users/<%= u.id %>/impersonate"><%- csrf %><button class="btn sm primary" data-confirm="Als <%= u.username %> ins Spiel wechseln? Du kannst oben zurückwechseln.">Als Spieler einloggen</button></form><% } %>
      <form method="post" action="/admin/users/<%= u.id %>/kick"><%- csrf %><button class="btn sm">Alle Sitzungen beenden</button></form>
      <form method="post" action="/admin/users/<%= u.id %>/password"><%- csrf %><button class="btn sm" data-confirm="Zufallspasswort setzen und anzeigen?">Zufallspasswort</button></form>
      <form method="post" action="/admin/users/<%= u.id %>/reset-character"><%- csrf %><button class="btn sm" data-confirm="Den aktuellen Charakter beenden (neues Leben möglich)?">Charakter beenden</button></form>
      <% if (u.id !== user.id) { %><form method="post" action="/admin/users/<%= u.id %>/delete"><%- csrf %><button class="btn sm danger" data-confirm="Konto und ALLE Charaktere unwiderruflich löschen?">Konto löschen</button></form><% } %>
    </div>
  </section>
</div>

<section class="card mt"><div class="card-title">Leben &amp; Generationen <span class="dim small">(zum Bearbeiten öffnen)</span></div>
  <div class="table-wrap"><table class="table"><thead><tr><th>#</th><th>Zyklus</th><th>Gen.</th><th>Name</th><th>Status</th><th class="num">Jahr</th><th class="num">Geld (Cent)</th><th>Ende</th><th></th></tr></thead>
  <tbody><% chars.forEach(function(c){ %><tr><td><%= c.id %></td><td><%= c.cycle %></td><td><%= c.generation %></td><td><%= c.name %></td><td><span class="chip <%= c.status === 'alive' ? 'good' : c.status === 'dead' ? 'warn' : '' %>"><%= c.status %></span></td><td class="num"><%= c.year %></td><td class="num"><%= c.money %></td><td class="dim small"><%= c.end_reason || '' %></td><td class="num"><a class="btn sm" href="/admin/characters/<%= c.id %>">Bearbeiten</a></td></tr><% }) %><% if (!chars.length) { %><tr><td colspan="9" class="dim">Noch kein Charakter.</td></tr><% } %></tbody></table></div></section>

<div class="grid c2 mt" style="--gap:1rem">
  <section class="card"><div class="card-title">Käufe</div>
    <table class="table small"><tbody><% purchases.forEach(function(p){ %><tr><td><%= p.package_id %></td><td class="num"><%= p.coins %> C</td><td class="num"><%= (p.price_cents / 100).toFixed(2) %> €</td><td class="dim"><%= p.provider %> · <%= p.status %></td><td class="dim"><%= new Date(p.created_at).toLocaleDateString('de-DE') %></td></tr><% }) %><% if (!purchases.length) { %><tr><td class="dim">Keine Käufe.</td></tr><% } %></tbody></table></section>
  <section class="card"><div class="card-title">Werbe-Belohnungen</div>
    <table class="table small"><tbody><% ads.forEach(function(a){ %><tr><td><%= a.purpose %></td><td class="num"><%= a.reward %></td><td class="dim"><%= a.claimed_at ? new Date(Number(a.claimed_at)).toLocaleString('de-DE') : 'nicht abgeschlossen' %></td></tr><% }) %><% if (!ads.length) { %><tr><td class="dim">Keine Einträge.</td></tr><% } %></tbody></table></section>
</div>
<section class="card mt"><div class="card-title">Letzte Aktivitäten</div>
  <table class="table"><tbody><% audits.forEach(function(a){ %><tr><td><%= a.action %></td><td class="dim small"><%= a.detail %></td><td class="dim small"><%= a.ip %></td><td class="num dim small"><%= new Date(a.created_at).toLocaleString('de-DE') %></td></tr><% }) %></tbody></table></section>
<%- include('_bottom') %>
