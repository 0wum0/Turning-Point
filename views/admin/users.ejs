<%- include('_top', { actions: '' }) %>
<form class="row" method="get" style="margin-bottom:1rem"><input type="search" name="q" value="<%= q %>" placeholder="Name oder E-Mail suchen …" style="max-width:360px"><button class="btn"><%- icon('search') %> Suchen</button><span class="dim small"><%= total %> Spieler</span></form>
<div class="table-wrap"><table class="table">
  <thead><tr><th>Name</th><th>E-Mail</th><th>Rolle</th><th class="num">Coins</th><th class="num">EFS</th><th>Zuletzt aktiv</th><th></th></tr></thead>
  <tbody><% rows.forEach(function(r){ %><tr>
    <td><a href="/admin/users/<%= r.id %>"><b><%= r.username %></b></a> <% if (r.banned) { %><span class="chip bad">gesperrt</span><% } %></td>
    <td class="dim"><%= r.email %></td><td><%= r.role === 'admin' ? 'Admin' : 'Spieler' %></td><td class="num"><%= r.coins %></td><td class="num"><%= r.efs_pool %></td>
    <td class="dim small"><%= r.last_seen_at ? new Date(r.last_seen_at).toLocaleString('de-DE') : '–' %></td><td class="num"><a class="btn sm" href="/admin/users/<%= r.id %>">Öffnen</a></td></tr><% }) %></tbody>
</table></div>
<div class="row center mt"><% if (page > 1) { %><a class="btn sm" href="?q=<%= encodeURIComponent(q) %>&page=<%= page - 1 %>">← Zurück</a><% } %><span class="dim small">Seite <%= page %> / <%= pages %></span><% if (page < pages) { %><a class="btn sm" href="?q=<%= encodeURIComponent(q) %>&page=<%= page + 1 %>">Weiter →</a><% } %></div>
<%- include('_bottom') %>
