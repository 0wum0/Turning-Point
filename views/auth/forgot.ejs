<%- include('../partials/head', { title: 'Passwort vergessen', era: 1, noindex: true }) %>
<%- include('../partials/topbar') %>
<main class="auth-wrap">
  <form class="card auth-card stack" method="post" action="/forgot">
    <div><h1>Passwort zurücksetzen</h1><p class="dim">Wir senden dir einen Link per E-Mail.</p></div>
    <% if (message) { %><div class="alert info"><%- icon('info') %><div><%= message %></div></div><% } %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label for="email">E-Mail</label><input id="email" name="email" type="email" required autofocus></div>
    <button class="btn primary block" type="submit">Link senden</button>
    <a class="small center" href="/login">Zurück zur Anmeldung</a>
  </form>
</main>
<%- include('../partials/foot') %>
