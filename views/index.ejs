<%- include('partials/head', { title: '', era: 1, css: ['landing'] }) %>
<%- include('partials/topbar') %>
<main>
  <section class="hero container">
    <span class="eyebrow"><%- icon('hourglass') %> <%= landing.eyebrow %></span>
    <h1><% landing.title.split('\n').forEach(function(l, i){ %><% if (i) { %><br><em><%= l %></em><% } else { %><%= l %><% } %><% }) %></h1>
    <p class="lead"><%= landing.lead %></p>
    <div class="row center">
      <% if (user) { %><a class="btn primary lg" href="/play"><%- icon('play') %> <%= landing.ctaPlay %></a>
      <% } else { %><a class="btn primary lg" href="/register"><%- icon('sparkles') %> <%= landing.ctaStart %></a><a class="btn lg" href="/login">Anmelden</a><% } %>
    </div>
    <div class="timeline-strip"><% landing.timeline.forEach(function(t, i){ %><span class="chip <%= i === 0 || i === landing.timeline.length - 1 ? 'accent' : '' %>"><%= t %></span><% }) %></div>
  </section>

  <section class="container stats-band"><% landing.stats.forEach(function(s){ %>
    <div class="card flat stat"><b><%= s.value %></b><span><%= s.label %></span></div><% }) %>
  </section>

  <section class="container mt2">
    <div class="panel-head"><div><h2><%= landing.featuresTitle %></h2><p><%= landing.featuresSub %></p></div></div>
    <div class="grid auto" style="--gap:1.1rem"><% landing.features.forEach(function(f){ %>
      <article class="card feature"><div class="ic"><%- icon(f.icon, 'lg') %></div><h3><%= f.title %></h3><p><%= f.text %></p></article><% }) %>
    </div>
  </section>

  <p class="quote"><%= landing.quote %></p>

  <section class="container center" style="margin-bottom:2rem">
    <% if (!user) { %><a class="btn primary lg" href="/register"><%= landing.ctaBottom %></a><% } else { %><a class="btn primary lg" href="/play"><%= landing.ctaBottomPlay %></a><% } %>
  </section>
</main>
<%- include('partials/foot') %>
