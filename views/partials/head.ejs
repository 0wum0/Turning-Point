<!doctype html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'de' %>" data-era="<%= typeof era !== 'undefined' ? era : 1 %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %><%= (typeof site !== 'undefined' && site.name) || 'Turning Point' %></title>
<meta name="description" content="Turning Point – Life. Work. Legacy. Eine Lebens-, Wirtschafts- und Familiensimulation über Generationen: von 1945 bis ins 22. Jahrhundert.">
<meta name="theme-color" content="#0b0d12">
<% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
<% if (typeof csrfToken !== 'undefined') { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<script src="/js/theme.js"></script>
<% if (typeof lang !== 'undefined' && lang === 'en') { %><script src="/i18n/en.js"></script><script src="/js/i18n.js?v=<%= assetV %>" defer></script><% } %>
<script src="/js/pwa.js" defer></script>
<script src="/js/motion.js?v=<%= assetV %>" defer></script>
<link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/app.css?v=<%= assetV %>">
<% (typeof css !== 'undefined' ? css : []).forEach(function(c){ %><link rel="stylesheet" href="/css/<%= c %>.css?v=<%= assetV %>">
<% }) %><link rel="stylesheet" href="/css/motion.css?v=<%= assetV %>">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
